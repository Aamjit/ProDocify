{
    "compilerOptions": {
        "module": "node16",
        "target": "es6",
        "lib": [
            "ES6"
        ],
        "declaration": true,
        "sourceMap": true,
        "rootDir": "./",
        "outDir": "dist",
        "strict": true,
        "moduleResolution": "node16",
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "incremental": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "./src/**/*.ts",
        "./prisma.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}